{
	"_about": "The tutorial's control checks (M8 D79, D80), in the order the instructor teaches them. An entry is documented in src/mission/control_check.gd; hint_line is the instructor's line in the mission's dialog file. Run one with m.check(id), or `checks start <id>` in the console.",
	"defaults": {"repeat_s": 20},
	"checks": [
		{"id": "autotrack_off", "label": "SWITCH AUTO-TRACK OFF", "actions": ["autotrack"], "press": "tap", "events": [],
			"kind": "state", "when": [{"field": "tracking", "op": "equals", "value": false}], "hint_line": "check_autotrack_off"},
		{"id": "pitch", "label": "PITCH THE NOSE UP OR DOWN", "actions": ["pitch_up", "pitch_down"], "keys_extra": "MOUSE",
			"kind": "rotation", "turn": "pitch", "min_deg": 45, "hint_line": "check_pitch"},
		{"id": "yaw", "label": "YAW THE NOSE LEFT OR RIGHT", "actions": ["yaw_left", "yaw_right"], "keys_extra": "MOUSE",
			"kind": "rotation", "turn": "yaw", "min_deg": 45, "hint_line": "check_yaw"},
		{"id": "roll", "label": "ROLL", "actions": ["roll_left", "roll_right"], "pad_extra": "R STICK DIAGONAL",
			"kind": "rotation", "turn": "roll", "min_deg": 180, "hint_line": "check_roll", "demo": "roll"},
		{"id": "main_pods", "label": "FIRE BOTH MAIN PODS", "actions": ["main_left", "main_right"], "need": "all",
			"kind": "velocity", "direction": "forward", "min_mps": 40, "hint_line": "check_main_pods"},
		{"id": "retros", "label": "FIRE BOTH RETRO PODS", "actions": ["retro_left", "retro_right"], "need": "all",
			"kind": "velocity", "direction": "back", "min_mps": 20, "hint_line": "check_retros"},
		{"id": "strafe_left", "label": "STRAFE LEFT", "actions": ["strafe_left"],
			"kind": "velocity", "direction": "left", "min_mps": 10, "hint_line": "check_strafe_left", "demo": "strafe_box"},
		{"id": "strafe_right", "label": "STRAFE RIGHT", "actions": ["strafe_right"],
			"kind": "velocity", "direction": "right", "min_mps": 10, "hint_line": "check_strafe_right", "demo": "strafe_box"},
		{"id": "strafe_up", "label": "STRAFE UP", "actions": ["strafe_up"],
			"kind": "velocity", "direction": "up", "min_mps": 10, "hint_line": "check_strafe_up", "demo": "strafe_box"},
		{"id": "strafe_down", "label": "STRAFE DOWN", "actions": ["strafe_down"],
			"kind": "velocity", "direction": "down", "min_mps": 10, "hint_line": "check_strafe_down", "demo": "strafe_box"},
		{"id": "assist_off", "label": "SWITCH FLIGHT ASSIST OFF", "actions": ["toggle_flight_assist"],
			"kind": "state", "when": [{"field": "assist", "op": "equals", "value": false}], "hint_line": "check_assist_off"},
		{"id": "assist_on", "label": "SWITCH FLIGHT ASSIST ON", "actions": ["toggle_flight_assist"],
			"kind": "state", "when": [{"field": "assist", "op": "equals", "value": true}], "hint_line": "check_assist_on"},
		{"id": "brake", "label": "HOLD THE BRAKE TO A STOP", "actions": ["brake"], "press": "hold",
			"kind": "brake", "hold_s": 1.0, "min_drop_mps": 10, "stop_mps": 1.0, "hint_line": "check_brake", "demo": "all_stop"},
		{"id": "camera_to_chase", "label": "SWITCH TO THE CHASE VIEW", "actions": ["toggle_camera"],
			"kind": "state", "when": [{"field": "camera", "op": "equals", "value": "chase"}], "hint_line": "check_camera_to_chase"},
		{"id": "camera_to_cockpit", "label": "SWITCH TO THE COCKPIT VIEW", "actions": ["toggle_camera"],
			"kind": "state", "when": [{"field": "camera", "op": "equals", "value": "cockpit"}], "hint_line": "check_camera_to_cockpit"},
		{"id": "free_look", "label": "LOOK AROUND", "actions": ["camera_look"], "press": "hold", "held": true,
			"pad_extra": "R STICK", "keys_extra": "MOUSE",
			"kind": "state", "when": [{"field": "look_deg", "op": "at_least", "value": 25}], "hint_line": "check_free_look"},
		{"id": "running_lights", "label": "SWITCH THE RUNNING LIGHTS", "actions": ["toggle_running_lights"],
			"kind": "state", "when": [{"field": "lights", "op": "changed"}], "hint_line": "check_running_lights"},
		{"id": "autotrack", "label": "AUTO-TRACK THE TARGET", "actions": ["autotrack"], "press": "tap",
			"kind": "state", "when": [{"field": "tracking", "op": "equals", "value": true}], "hint_line": "check_autotrack"},
		{"id": "interact", "label": "RUN THE TARGET'S INTERACTION", "actions": ["autotrack"], "press": "hold", "events": ["interact"],
			"kind": "state", "when": [{"field": "interactions", "op": "increased"}], "hint_line": "check_interact"},
		{"id": "target_menu", "label": "PICK A TARGET FROM THE TARGET MENU", "actions": ["target_cycle", "target_next"], "press": "hold",
			"events": [],
			"kind": "state", "when": [{"field": "target_menus", "op": "increased"}, {"field": "target", "op": "set"}],
			"hint_line": "check_target_menu"},
		{"id": "target_next", "label": "NEXT TARGET", "actions": ["target_cycle", "target_next"], "press": "tap",
			"events": ["target_next"], "keys_extra": "MOUSE WHEEL DOWN",
			"kind": "state", "when": [{"field": "target", "op": "changed"}, {"field": "target", "op": "set"}],
			"hint_line": "check_target_next"},
		{"id": "fire_linked", "label": "SWITCH THE GUNS TO LINKED FIRE", "actions": ["weapon_next"],
			"kind": "state", "when": [{"field": "fire_mode", "op": "equals", "value": "linked"}], "hint_line": "check_fire_linked"},
		{"id": "fire_alternating", "label": "SWITCH THE GUNS TO ALTERNATING FIRE", "actions": ["weapon_next"],
			"kind": "state", "when": [{"field": "fire_mode", "op": "equals", "value": "alternating"}],
			"hint_line": "check_fire_alternating"},
		{"id": "wing_form", "label": "COMMS MENU: FORM ON ME", "actions": ["comms_menu", "wing_form"], "events": [],
			"kind": "state", "when": [{"field": "wing_orders", "op": "increased"}, {"field": "wing_order", "op": "equals", "value": "form"}],
			"hint_line": "check_wing_form"},
		{"id": "wing_attack", "label": "COMMS MENU: ATTACK MY TARGET", "actions": ["comms_menu", "wing_attack"], "events": [],
			"kind": "state", "when": [{"field": "wing_orders", "op": "increased"}, {"field": "wing_order", "op": "equals", "value": "attack"}],
			"hint_line": "check_wing_attack"},
		{"id": "wing_cover", "label": "COMMS MENU: COVER ME", "actions": ["comms_menu", "wing_cover"], "events": [],
			"kind": "state", "when": [{"field": "wing_orders", "op": "increased"}, {"field": "wing_order", "op": "equals", "value": "cover"}],
			"hint_line": "check_wing_cover"}
	]
}
