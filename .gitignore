# --- Godot 4 ---
.godot/
/android/
*.translation
export_credentials.cfg
.import/
*.tmp
.nomedia

# Godot .NET (not used, kept so a stray C# experiment never lands in git)
.mono/
data_*/
mono_crash.*.json

# --- Project-specific ---
# Local engine binary installed by scripts/setup_godot.sh; also cargo's build files for native/ (.tools/native-target)
.tools/
# The native library scripts/build_native.sh builds, and cargo's build files if it runs in native/ without the script
/bin/*.so
/native/target/
# Everything under assets/generated/ is produced by tools/ (see docs/architecture.md, "Asset pipeline").
# Regenerate with scripts/gen_assets.sh. Never commit these binaries.
assets/generated/
# Test reports (JUnit XML from GUT, logs from CI)
reports/
*.log

# --- Python (tools/) ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Claude Code agent worktrees (local only) ---
.claude/worktrees/
references/
