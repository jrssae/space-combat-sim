root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,gdshader,glsl,tscn,tres,godot,cfg}]
indent_style = tab
indent_size = 4

[*.{py,sh,md,yml,yaml,json,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
